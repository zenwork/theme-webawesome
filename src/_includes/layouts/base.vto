<!DOCTYPE html>
<html lang="{{ lang || metas.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title || metas.title }} - {{ metas.site }}</title>
    <meta name="color-scheme" content="light dark">
    <script>
      ;(() => {
        const lightTheme = 'wa-light'
        const darkTheme = 'wa-dark'
        const saved = window.localStorage.getItem('theme')
        const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const next = saved === darkTheme || saved === lightTheme ? saved : preferredDark ? darkTheme : lightTheme
        document.documentElement.classList.add(next)
      })()
    </script>
    <style>
      wa-drawer:not(:defined),
      site-toc-tree:not(:defined),
      wa-tree:not(:defined),
      wa-tree-item:not(:defined) {
        display: none;
      }

      site-toc-tree:defined:not([data-ready]) {
        visibility: hidden;
      }
    </style>
    <link rel="preload" href="{{ webawesome.cssPath }}" as="style">
    {{ if webawesome.customPropertiesCssPath }}
      <link rel="preload" href="{{ webawesome.customPropertiesCssPath }}" as="style">
    {{ /if }}
    <link rel="preload" href="{{ webawesome.loaderPath }}" as="script">
    <link rel="stylesheet" href="/style.css">
    <link rel="canonical" href="{{ url |> url(true) }}">
    {{# WEBAWESOME COMPONENT LIBRARY #}}
    <link rel="stylesheet" href="{{ webawesome.cssPath }}" />
    {{ if webawesome.customPropertiesCssPath }}
      <link rel="stylesheet" href="{{ webawesome.customPropertiesCssPath }}" />
    {{ /if }}
    <script type="module" src="{{ webawesome.loaderPath }}" data-webawesome="{{ webawesome.assetBasePath }}"></script>
    <script
      type="module"
      src="{{ webawesome.splitPanelPath }}"
      data-webawesome="{{ webawesome.assetBasePath }}"
    ></script>
    <script
      type="module"
      src="{{ webawesome.assetBasePath }}/components/details/details.js"
      data-webawesome="{{ webawesome.assetBasePath }}"
    ></script>
    <script
      type="module"
      src="{{ webawesome.assetBasePath }}/components/button/button.js"
      data-webawesome="{{ webawesome.assetBasePath }}"
    ></script>
    <script
      type="module"
      src="{{ webawesome.assetBasePath }}/components/icon/icon.js"
      data-webawesome="{{ webawesome.assetBasePath }}"
    ></script>
    <script
      type="module"
      src="{{ webawesome.assetBasePath }}/components/input/input.js"
      data-webawesome="{{ webawesome.assetBasePath }}"
    ></script>
    {{# CUSTOM COMPONENTS #}}
    <script type="module" src="{{ themeComponents.primaryScript }}"></script>
  </head>
  <body>
    {{ set currentPathParts = (url || '/').split('/').filter((part) => part.length > 0) }}
    {{ set currentSectionKey = currentPathParts[0] || '' }}
    {{ set sectionChoices = themeNavigation?.sections || [] }}
    {{ set sectionNavigation = sectionChoices.length > 1 }}
    {{
      set activeSection = sectionNavigation
      ? (sectionChoices.find((section) => section.baseUrl && url.startsWith(section.baseUrl)) ||
        sectionChoices.find((section) => section.key === currentSectionKey) ||
        sectionChoices[0])
      : sectionChoices[0]
    }}
    {{ set sectionChooserVisible = sectionNavigation && sectionChoices.length > 1 }}
    {{ set siteNavigationHeading = sectionNavigation ? (activeSection?.title || 'Documentation') : 'Documentation' }}

    <wa-drawer id="site-toc-drawer" label="Menu" placement="start">
      <section>
        {{ if sectionChooserVisible }}
          <nav class="site-section-drawer" aria-label="Sections">
            {{ for section of sectionChoices }}
              <a
                href="{{ section.url }}"
                class="site-section-link {{ if activeSection?.key === section.key }}is-active{{ /if }}"
              >
                {{ section.title }}
              </a>
            {{ /for }}
          </nav>
        {{ /if }}
      </section>
      <section class="site-toc-shell">
        {{ include '../section-toc.vto' }}
      </section>
    </wa-drawer>
    <header class="site-header">
      <div class="site-header-inner">
        <wa-button
          class="site-toc-trigger"
          appearance="outlined"
          variant="brand"
          size="small"
          id="site-toc-trigger"
        ><wa-icon name="bars" label="bars"></wa-icon></wa-button>
        <a class="site-title" href="/">{{ metas.site }}</a>
        {{ if sectionChooserVisible }}
          <span class="site-section-drawer">{{ activeSection?.title || siteNavigationHeading }}</span>
        {{ /if }}
        {{ if sectionChooserVisible }}
          <nav class="site-section-nav" aria-label="Sections">
            {{ for section of sectionChoices }}
              <a
                href="{{ section.url }}"
                class="site-section-link {{ if activeSection?.key === section.key }}is-active{{ /if }}"
              >
                {{ section.title }}
              </a>
            {{ /for }}
          </nav>
        {{ /if }}
        <div class="site-search">
          <wa-input
            class="site-search-input"
            type="search"
            size="small"
            appearance="outlined"
            placeholder="Search docs"
            aria-label="Search documentation"
          >
            <wa-icon slot="start" name="magnifying-glass" label="Search"></wa-icon>
          </wa-input>
        </div>
        {{ include '../theme-toggle.vto' }}
      </div>
    </header>
    <main class="docs-shell">
      <aside class="site-toc-panel">
        <section class="site-toc-shell">
          {{ include '../section-toc.vto' }}
        </section>
      </aside>
      {{ if toc?.length }}
        <section class="page-toc-mobile">
          <section class="page-toc-shell">
            <h2>On this page</h2>
            <nav aria-label="Page table of contents">
              <ol class="page-toc-list">
                {{ for item of toc }}
                  <li>
                    <a href="{{ item.slug ? `#${item.slug}` : item.url }}" class="toc-link">{{ item.text }}</a>
                    {{ if item.children.length }}
                      <ul class="page-toc-list">
                        {{ for child of item.children }}
                          <li>
                            <a href="{{ child.slug ? `#${child.slug}` : child.url }}" class="toc-link">{{
                              child.text
                            }}</a>
                          </li>
                        {{ /for }}
                      </ul>
                    {{ /if }}
                  </li>
                {{ /for }}
              </ol>
            </nav>
          </section>
        </section>
      {{ /if }}
      <article class="docs-content">
        <div class="docs-content-actions">
          <wa-button id="copy-page-markdown" variant="neutral" appearance="outlined" size="small">
            <wa-icon name="copy" label="Copy page as markdown" slot="start"></wa-icon>
            Copy as Markdown
          </wa-button>
        </div>
        {{ content }}
      </article>
      {{ if toc?.length }}
        <aside class="page-toc-panel">
          <section class="page-toc-shell">
            <h2>On this page</h2>
            <nav aria-label="Page table of contents">
              <ol class="page-toc-list">
                {{ for item of toc }}
                  <li>
                    <a href="{{ item.slug ? `#${item.slug}` : item.url }}" class="toc-link">{{ item.text }}</a>
                    {{ if item.children.length }}
                      <ul class="page-toc-list">
                        {{ for child of item.children }}
                          <li>
                            <a href="{{ child.slug ? `#${child.slug}` : child.url }}" class="toc-link">{{
                              child.text
                            }}</a>
                          </li>
                        {{ /for }}
                      </ul>
                    {{ /if }}
                  </li>
                {{ /for }}
              </ol>
            </nav>
          </section>
        </aside>
      {{ /if }}
    </main>
    <script>
      ;(() => {
        const docsContent = document.querySelector('.docs-content')
        const copyButton = document.getElementById('copy-page-markdown')

        if (!docsContent || !copyButton || !navigator.clipboard?.writeText) {
          if (copyButton) {
            copyButton.setAttribute('disabled', '')
          }
          return
        }

        const skipActionClass = 'docs-content-actions'

        const normalizeInline = (value) => value.replace(/[ \t]+/g, ' ').replace(/\s+\n/g, '\n').trim()

        const toInlineMarkdown = (node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            return node.textContent || ''
          }

          if (node.nodeType !== Node.ELEMENT_NODE) {
            return ''
          }

          const element = /** @type {HTMLElement} */ (node)
          const tag = element.tagName
          const content = Array.from(element.childNodes).map(toInlineMarkdown).join('')

          if (tag === 'BR') {
            return '  \n'
          }

          if (tag === 'CODE') {
            const code = normalizeInline(element.textContent || '')
            return code ? `\`${code}\`` : ''
          }

          if (tag === 'A') {
            const label = normalizeInline(content || element.textContent || '')
            const href = element.getAttribute('href') || ''
            return label && href ? `[${label}](${href})` : label
          }

          if (tag === 'STRONG' || tag === 'B') {
            const value = normalizeInline(content)
            return value ? `**${value}**` : ''
          }

          if (tag === 'EM' || tag === 'I') {
            const value = normalizeInline(content)
            return value ? `*${value}*` : ''
          }

          if (tag === 'IMG') {
            const alt = element.getAttribute('alt') || ''
            const src = element.getAttribute('src') || ''
            return src ? `![${alt}](${src})` : ''
          }

          return content
        }

        const toListMarkdown = (list, depth = 0) => {
          const ordered = list.tagName === 'OL'
          const items = Array.from(list.children).filter((child) => child.tagName === 'LI')
          const lines = []

          items.forEach((item, index) => {
            const marker = ordered ? `${index + 1}.` : '-'
            const prefix = `${'  '.repeat(depth)}${marker} `
            const inlineParts = []
            const nestedLists = []

            for (const child of item.childNodes) {
              if (child.nodeType === Node.ELEMENT_NODE) {
                const childElement = /** @type {HTMLElement} */ (child)
                if (childElement.tagName === 'UL' || childElement.tagName === 'OL') {
                  nestedLists.push(toListMarkdown(childElement, depth + 1))
                  continue
                }
              }
              inlineParts.push(toInlineMarkdown(child))
            }

            const line = normalizeInline(inlineParts.join(''))
            if (line) {
              lines.push(`${prefix}${line}`)
            }

            nestedLists.forEach((nested) => {
              if (nested) {
                lines.push(nested)
              }
            })
          })

          return lines.join('\n')
        }

        const toBlockMarkdown = (element) => {
          const tag = element.tagName

          if (/^H[1-6]$/.test(tag)) {
            const level = Number(tag.slice(1))
            const title = normalizeInline(Array.from(element.childNodes).map(toInlineMarkdown).join(''))
            return title ? `${'#'.repeat(level)} ${title}` : ''
          }

          if (tag === 'P') {
            return normalizeInline(Array.from(element.childNodes).map(toInlineMarkdown).join(''))
          }

          if (tag === 'PRE') {
            const code = element.querySelector('code')
            const source = (code?.textContent || element.textContent || '').replace(/\n+$/g, '')
            const language = code?.className.match(/language-([a-z0-9_-]+)/i)?.[1] || ''
            return `\`\`\`${language}\n${source}\n\`\`\``
          }

          if (tag === 'UL' || tag === 'OL') {
            return toListMarkdown(element)
          }

          if (tag === 'BLOCKQUOTE') {
            const quote = normalizeInline(element.textContent || '')
            return quote
              .split('\n')
              .filter(Boolean)
              .map((line) => `> ${line}`)
              .join('\n')
          }

          if (tag === 'HR') {
            return '---'
          }

          if (tag === 'TABLE') {
            return normalizeInline(element.textContent || '')
          }

          return normalizeInline(Array.from(element.childNodes).map(toInlineMarkdown).join(''))
        }

        const buildMarkdown = () => {
          const blocks = []
          for (const child of docsContent.children) {
            if (child.classList.contains(skipActionClass)) {
              continue
            }
            const block = toBlockMarkdown(child)
            if (block) {
              blocks.push(block)
            }
          }
          return blocks.join('\n\n').replace(/\n{3,}/g, '\n\n').trim()
        }

        copyButton.addEventListener('click', async () => {
          const markdown = buildMarkdown()
          if (!markdown) {
            return
          }

          try {
            await navigator.clipboard.writeText(markdown)
            const icon = copyButton.querySelector('wa-icon')
            const textNode = Array.from(copyButton.childNodes).find((node) =>
              node.nodeType === Node.TEXT_NODE && node.textContent?.trim()
            )
            if (icon) {
              icon.setAttribute('name', 'check')
            }
            if (textNode) {
              textNode.textContent = ' Copied Markdown'
            }
            window.setTimeout(() => {
              if (icon) {
                icon.setAttribute('name', 'copy')
              }
              if (textNode) {
                textNode.textContent = ' Copy as Markdown'
              }
            }, 1400)
          } catch {
            const icon = copyButton.querySelector('wa-icon')
            if (icon) {
              icon.setAttribute('name', 'xmark')
              window.setTimeout(() => icon.setAttribute('name', 'copy'), 1400)
            }
          }
        })
      })()
    </script>
    <script>
      ;(() => {
        const searchInput = document.querySelector('.site-search-input')
        if (!searchInput) {
          return
        }

        document.addEventListener('keydown', (event) => {
          if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) {
            return
          }

          if (event.key !== '/') {
            return
          }

          const active = document.activeElement
          const inEditableContext = active instanceof HTMLElement &&
            (
              active.isContentEditable ||
              active.tagName === 'INPUT' ||
              active.tagName === 'TEXTAREA' ||
              active.tagName === 'SELECT'
            )

          if (inEditableContext) {
            return
          }

          if (!(searchInput instanceof HTMLElement) || searchInput.offsetParent === null) {
            return
          }

          event.preventDefault()
          searchInput.focus()
        })
      })()
    </script>
    <script>
      ;(() => {
        const trigger = document.getElementById('site-toc-trigger')
        const drawer = document.getElementById('site-toc-drawer')
        if (trigger && drawer) {
          let openedAt = 0
          const stopEvent = (event) => {
            event.preventDefault()
            event.stopPropagation()
          }

          trigger.addEventListener('pointerdown', stopEvent, { capture: true })
          trigger.addEventListener('pointerup', stopEvent, { capture: true })
          trigger.addEventListener('click', (event) => {
            stopEvent(event)
            openedAt = Date.now()
            window.setTimeout(() => drawer.show(), 0)
          }, { capture: true })

          drawer.addEventListener('wa-hide', (event) => {
            if (Date.now() - openedAt < 400) {
              event.preventDefault()
            }
          })
        }

        const header = document.querySelector('.site-header')
        const pageTocRoots = Array.from(document.querySelectorAll('.page-toc-panel, .page-toc-mobile'))
        if (!pageTocRoots.length) {
          return
        }

        const tocLinks = pageTocRoots.flatMap((tocRoot) =>
          Array.from(tocRoot.querySelectorAll('a.toc-link[href^="#"]'))
        )
        if (!tocLinks.length) {
          return
        }

        const parseHashId = (hash) => {
          if (!hash || hash[0] !== '#') {
            return ''
          }
          const raw = hash.slice(1)
          try {
            return decodeURIComponent(raw)
          } catch {
            return raw
          }
        }

        const getHeaderOffset = () => {
          const headerHeight = header?.getBoundingClientRect().height ?? 0
          return Math.round(headerHeight + 12)
        }

        const syncHeaderOffsetVar = () => {
          document.documentElement.style.setProperty('--site-header-scroll-offset', `${getHeaderOffset()}px`)
        }

        const tocItemsById = new Map()
        for (const link of tocLinks) {
          const id = parseHashId(link.hash)
          if (!id) {
            continue
          }

          const target = document.getElementById(id)
          if (!target) {
            continue
          }

          const existing = tocItemsById.get(id)
          if (existing) {
            existing.links.push(link)
            continue
          }

          tocItemsById.set(id, { id, target, links: [link] })
        }
        const tocItems = Array.from(tocItemsById.values())

        if (!tocItems.length) {
          return
        }

        const setActiveToc = (activeId) => {
          for (const { id, links } of tocItems) {
            for (const link of links) {
              link.classList.toggle('is-active', id === activeId)
              if (id === activeId) {
                link.setAttribute('aria-current', 'location')
              } else {
                link.removeAttribute('aria-current')
              }
            }
          }
        }

        const scrollToHeading = (id, behavior = 'smooth') => {
          const item = tocItems.find((entry) => entry.id === id)
          if (!item) {
            return
          }
          const targetTop = item.target.getBoundingClientRect().top + window.scrollY - getHeaderOffset()
          window.scrollTo({ top: Math.max(0, targetTop), behavior })
        }

        const updateActiveFromScroll = () => {
          const offset = getHeaderOffset()
          const activationOffset = offset + 24
          const viewportHeight = window.innerHeight || 0
          const atPageBottom = window.scrollY + viewportHeight >= document.documentElement.scrollHeight - 2

          if (atPageBottom) {
            setActiveToc(tocItems[tocItems.length - 1].id)
            return
          }

          let activeId = tocItems[0].id
          for (const { id, target } of tocItems) {
            if (target.getBoundingClientRect().top <= activationOffset) {
              activeId = id
            } else {
              break
            }
          }
          setActiveToc(activeId)
        }

        for (const { id, links } of tocItems) {
          for (const link of links) {
            link.addEventListener('click', (event) => {
              event.preventDefault()
              scrollToHeading(id, 'smooth')
              history.pushState(null, '', `#${encodeURIComponent(id)}`)
              setActiveToc(id)
            })
          }
        }

        const hashId = parseHashId(window.location.hash)
        syncHeaderOffsetVar()
        if (hashId) {
          const item = tocItems.find((entry) => entry.id === hashId)
          if (item) {
            requestAnimationFrame(() => scrollToHeading(hashId, 'auto'))
            setActiveToc(hashId)
          } else {
            updateActiveFromScroll()
          }
        } else {
          updateActiveFromScroll()
        }

        window.addEventListener('scroll', updateActiveFromScroll, { passive: true })
        window.addEventListener('resize', () => {
          syncHeaderOffsetVar()
          updateActiveFromScroll()
        })
        window.addEventListener('hashchange', () => {
          const nextId = parseHashId(window.location.hash)
          if (!nextId) {
            updateActiveFromScroll()
            return
          }
          scrollToHeading(nextId, 'auto')
          setActiveToc(nextId)
        })
      })()
    </script>
  </body>
</html>
