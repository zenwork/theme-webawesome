---
layout: layouts/base.vto
title: Component Examples
order: 2
---
<section class="docs-stack">
  <header>
    <h1>{{ title }}</h1>
    <p class="lead">
      Feature coverage page for <code>code-example</code> and <code>demo-pane</code> in the test site.
    </p>
  </header>

  <section class="docs-section">
    <h2>Code Example (Typed Source)</h2>
    <!-- deno-fmt-ignore -->
    <code-example language="typescript">
import { html } from 'lit'

const release = {
  version: 'v0.2.0',
  status: 'stable',
}

console.log(`${release.version} is ${release.status}`)
    </code-example>
  </section>

  <section class="docs-section">
    <h2>Code Example (Slotted HTML)</h2>
    <!-- deno-fmt-ignore -->
    <code-example>
<wa-callout variant="brand">
  <strong>Auto-detected HTML</strong>
  <p>Slotted markup should render as source without escaping.</p>
</wa-callout>
    </code-example>
  </section>

  <section class="docs-section">
    <h2>Code Example (CSS)</h2>
    <!-- deno-fmt-ignore -->
    <code-example language="css">
.release-banner {
  display: grid;
  gap: 0.5rem;
  color: var(--wa-color-brand-fill-loud);
}
    </code-example>
  </section>

  <section class="docs-section">
    <h2>Code Example (Padded TSX)</h2>
    <!-- deno-fmt-ignore -->
    <code-example language="tsx" padded>
export function ReleaseBadge() {
  return &lt;wa-badge variant="success"&gt;Ready&lt;/wa-badge&gt;
}
    </code-example>
  </section>

  <section class="docs-section">
    <h2>Editable Demo Pane</h2>
    <demo-pane
      data='{"title":"Release v0.2.0","state":"Ready","items":["Navigation offsets","TOC active state","Resizable editors"]}'
      template='<wa-card><strong>${title}</strong><div style="margin-top:.5rem;display:flex;gap:.5rem;flex-wrap:wrap"><wa-badge variant="success">${state}</wa-badge></div><ul style="margin:.75rem 0 0 1rem">${items.map((item) => html`<li>${item}</li>`)}</ul></wa-card>'
      imports='["card","badge"]'
      style="--demo-pane-output-background: var(--wa-color-neutral-50)"
      editor-open
    >
    </demo-pane>
  </section>

  <section class="docs-section">
    <h2>Read-only Demo Pane</h2>
    <demo-pane
      data='{"label":"Deploy","state":"Stable","version":"v0.2.0"}'
      template='<div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap"><wa-button variant="brand" size="small">${label}</wa-button><wa-badge variant="success">${state}</wa-badge><wa-badge variant="neutral">${version}</wa-badge></div>'
      imports='["button","badge"]'
      readonly
      fit-content
    >
    </demo-pane>
  </section>

  <section class="docs-section">
    <h2>Long Output + Fit Action</h2>
    <demo-pane
      data='{"title":"Long Output","rows":["Row 01: release context","Row 02: release context","Row 03: release context","Row 04: release context","Row 05: release context","Row 06: release context","Row 07: release context","Row 08: release context","Row 09: release context","Row 10: release context","Row 11: release context","Row 12: release context","Row 13: release context","Row 14: release context","Row 15: release context","Row 16: release context","Row 17: release context","Row 18: release context","Row 19: release context","Row 20: release context","Row 21: release context","Row 22: release context","Row 23: release context","Row 24: release context","Row 25: release context","Row 26: release context","Row 27: release context","Row 28: release context","Row 29: release context","Row 30: release context"]}'
      template='<section><h3>${title}</h3><div style="display:grid;gap:.25rem">${rows.map((row) => html`<p style="margin:0">${row}</p>`)}</div></section>'
      style="--demo-pane-output-background: var(--wa-color-neutral-50)"
      editor-open
    >
    </demo-pane>
  </section>
</section>
